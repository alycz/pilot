# Non-secret defaults only. Secrets belong in an owner-controlled external Harbor environment file.
# These empty entries document required secret names without providing values.
HARBOR_API_KEYS=
HARBOR_KEK=
TEST_WALLETS_TESTNET=
TEST_WALLETS_DEVNET=
HARBOR_SOURCE_TAG=2610240
EXEC_NETWORK=testnet
MAINNET_EXECUTION=false
EXECUTOR=dynamic
# Existing paid/local profiles retain MCP code execution. The Free/QuickJS
# profile sets this to false until its Worker CPU acceptance gate passes.
HARBOR_MCP_EXECUTION_ENABLED=true
# HARBOR_DEPLOYMENT_PROFILE=free-quickjs
HARBOR_LOCAL_DEV=true
# Optional trust-flow fixtures remain off unless an operator explicitly opts in
# to the fixed local Testnet/mock contracts documented in docs/ledger-trust-flows.md.
HARBOR_LOCAL_X402_OWNER_REVIEW_ENABLED=false
HARBOR_LOCAL_CAPABILITY_RUNTIME_ENABLED=false
HARBOR_LOCAL_WORK_AGREEMENT_ENABLED=false

# AWS trust layer. Local development must bind AWS_ENDPOINT_OVERRIDE to the
# loopback stand-in; live AWS credentials are event-day secrets and stay unset.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_OVERRIDE=http://127.0.0.1:8790
GUARDRAILS_MODE=mock
GUARDRAILS_THRESHOLD=0.8
KMS_MODE=off
HARBOR_KEK_CIPHERTEXT=

# Mastercard AP4M event rail. This isolated XRPL EVM Testnet adapter is
# deliberately disabled and signerless. `mock` is the only implemented mode;
# it performs no network requests, signing, submission, scheduling, or fallback.
# The chain, RPC, explorer, PaymentLedger, pooled vault, and RLUSD contract are
# code-owned allowlist values rather than operator-configurable inputs.
AP4M_EVM_EVENT_ENABLED=false
AP4M_EVM_EVENT_MODE=off

# QuickNode. Mock mode uses the public XRPL fallback while the local KV,
# webhook, and Streams stand-in binds to the task-isolated loopback port 8793.
# QuickNode endpoint URLs and security tokens are event-day secrets and stay unset.
QN_MODE=mock
QN_XRPL_TESTNET_HTTP=
XRPL_FALLBACK_TESTNET_HTTP=https://s.altnet.rippletest.net:51234/
QN_API_KEY=
QN_API_BASE=http://127.0.0.1:8793
QN_WEBHOOK_SECURITY_TOKEN=
QN_STREAM_SECURITY_TOKEN=
QN_RUN_TAG=run1
QN_WATCHDOG_ACTION=freeze
HARBOR_PUBLIC_URL=

# Shared demo-model quota authority. The complete contract is listed even
# though the feature is default-off; enabling it requires reviewed nonzero
# limits, an allowed free-model list, and matching Pilot policy/version values.
HARBOR_DEMO_QUOTA_ENABLED=0
HARBOR_DEMO_QUOTA_PRINCIPAL=
HARBOR_DEMO_COST_POLICY=
HARBOR_DEMO_POLICY_VERSION=
HARBOR_DEMO_ALLOWED_MODELS=
HARBOR_DEMO_GLOBAL_DAILY_OUTPUT_TOKENS=0
HARBOR_DEMO_GLOBAL_DAILY_REQUESTS=0
HARBOR_DEMO_WALLET_DAILY_OUTPUT_TOKENS=0
HARBOR_DEMO_WALLET_DAILY_REQUESTS=0
HARBOR_DEMO_RATE_WINDOW_SECONDS=0
HARBOR_DEMO_RATE_REQUESTS=0
HARBOR_DEMO_MAX_GLOBAL_CONCURRENCY=0
HARBOR_DEMO_MAX_WALLET_CONCURRENCY=0
HARBOR_DEMO_RESERVATION_TTL_SECONDS=0
HARBOR_DEMO_ABORT_GRACE_SECONDS=0
HARBOR_DEMO_MAX_INPUT_BYTES=0
HARBOR_DEMO_MAX_OUTPUT_TOKENS=0
HARBOR_DEMO_MAX_STEPS=0
