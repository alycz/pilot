		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.1",
		"minisearch": "^7.2.0",
		"quickjs-emscripten": "^0.32.0",
		"xrpl": "^5.3.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.4",
		"@types/node": "^26.6.5",
		"typescript": "^5.9.3",
		"vitest": "~4.1.0",
		"wrangler": "^4.151.1"
	}
}
