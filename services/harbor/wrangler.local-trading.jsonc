{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "harbor-local-trading-only",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "harbor-local-trading-only",
      "database_id": "11111111-1111-1111-1111-111111111111",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "vars": {
    "HARBOR_SOURCE_TAG": "2610240",
    "EXEC_NETWORK": "testnet",
    "MAINNET_EXECUTION": "false",
    "EXECUTOR": "quickjs",
    "HARBOR_LOCAL_DEV": "true",
    "HARBOR_LOCAL_READ_ONLY": "false",
    "HARBOR_LOCAL_AUTH_REQUIRED": "true",
    "HARBOR_LOCAL_CRON_DISABLED": "true",
    "HARBOR_LOCAL_X402": "false",
    "HARBOR_LOCAL_X402_RUNTIME_ENABLED": "false",
    "HARBOR_LOCAL_TRADING_RUNTIME_ENABLED": "true",
    "HARBOR_LOCAL_TRADING_SIGNING_PROFILE": "reviewed-testnet-local-trading-v1"
  }
}
