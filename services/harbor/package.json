{
	"name": "pilot-execution-service",
	"version": "0.0.0",
	"private": true,
	"packageManager": "npm@11.9.0",
	"engines": {
		"node": "24.14.0"
	},
	"scripts": {
		"aws-local": "node --experimental-transform-types tools/aws-local/src/index.ts",
		"generate": "node scripts/build-catalog.mjs",
		"qn-local": "node --experimental-transform-types tools/qn-local/src/index.ts",
		"predev": "node scripts/build-catalog.mjs",
		"dev": "wrangler dev",
		"dev:local": "node scripts/dev-local.mjs",
		"dev:local:x402": "node scripts/dev-local-x402.mjs",
		"dev:local:x402:isolated:v1": "node scripts/dev-local-x402-isolated-v1.mjs",
		"dev:local:trading": "node scripts/dev-local-trading.mjs",
		"dev:local:trading:isolated:v1": "node scripts/dev-local-trading-isolated-v1.mjs",
		"dev:local:trading:isolated:v1:onboarding": "node scripts/dev-local-trading-isolated-v1-onboarding.mjs",
		"dev:local:trading:onboarding": "node scripts/dev-local-trading-onboarding.mjs",
		"provision:local:trading": "umask 077 && node --experimental-transform-types scripts/provision-local-trading.ts",
		"provision:local:x402": "umask 077 && node --experimental-transform-types scripts/provision-local-x402.ts",
		"provision:local:x402:isolated:v1": "umask 077 && node --experimental-transform-types scripts/provision-local-x402-isolated-v1.ts",
		"pretypecheck": "node scripts/build-catalog.mjs",
		"typecheck": "tsc --noEmit",
		"pretest": "node scripts/build-catalog.mjs",
		"test": "vitest run",
		"repro:verify": "node ../../scripts/integrity/verify.mjs",
		"test:smoke": "vitest run --config vitest.smoke.config.mts",
		"predeploy": "node scripts/build-catalog.mjs",
		"deploy": "wrangler deploy",
		"config:free:generate": "node scripts/configure-deployment.mjs",
		"migrations:free:check": "node scripts/verify-free-quickjs-migrations.mjs",
		"predeploy:free:dry-run": "node scripts/build-catalog.mjs",
		"deploy:free:dry-run": "wrangler deploy --dry-run --config wrangler.free-quickjs.jsonc",
		"cf-typegen": "wrangler types --env-file .env.example",
		"cf-typegen:check": "wrangler types --env-file .env.example --check",
		"cf-typegen:free": "wrangler types worker-configuration.free-quickjs.d.ts --config wrangler.free-quickjs.jsonc --env-interface FreeQuickJsEnv --include-runtime false",
		"cf-typegen:free:check": "wrangler types worker-configuration.free-quickjs.d.ts --config wrangler.free-quickjs.jsonc --env-interface FreeQuickJsEnv --include-runtime false --check"
	},
	"dependencies": {
		"@defuse-protocol/one-click-sdk-typescript": "0.1.26",
		"@modelcontextprotocol/sdk": "^1.32.1",
		"@noble/curves": "^2.4.0",
		"aws4fetch": "^1.0.20",
		"minisearch": "^7.2.0",
		"quickjs-emscripten": "^0.32.0",
		"ripple-keypairs": "^3.1.0",
		"viem": "2.57.11",
		"xrpl": "^5.3.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.4",
		"@types/node": "^26.6.5",
		"typescript": "^5.9.3",
		"vitest": "~4.1.0",
		"wrangler": "4.151.1"
	}
}
