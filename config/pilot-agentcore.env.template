# AgentCore is an optional research worker, not Pilot's model provider or
# transaction authority. The safe default performs no AgentCore calls.
AGENTCORE_MODE=off

# Local contract/demo mode only. Start the clearly labelled loopback stand-in
# in the same local harness and use the loopback origin it returns. Never use
# this mode as AWS evidence.
# AGENTCORE_MODE=standin
# AGENTCORE_STANDIN_URL=http://127.0.0.1:32147

# Future account-time AWS setup. Do not place credentials or OAuth tokens here.
# The documented workload-token path uses a fresh server-resolved OAuth access
# token for each direct HTTPS invocation. Pilot verifies the token locally before
# dispatch. The resolver and optional revocation checker are server-only injected
# dependencies; this file contains only their reviewed non-secret policy.
# AGENTCORE_MODE=aws
# AGENTCORE_AWS_REGION=us-east-2
# AGENTCORE_RUNTIME_AUTH_MODE=oauth_jwt
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-2:123456789012:runtime/pilot_research-AbCdEf1234
# AGENTCORE_RUNTIME_QUALIFIER=pilot_v1
# AGENTCORE_RUNTIME_JWT_ISSUER=https://replace-with-reviewed-issuer.example/
# AGENTCORE_RUNTIME_JWT_JWKS_URL=https://replace-with-reviewed-issuer.example/.well-known/jwks.json
# AGENTCORE_RUNTIME_JWT_AUDIENCES_JSON=["pilot-agentcore-runtime"]
# AGENTCORE_RUNTIME_JWT_ALLOWED_SUBJECTS_JSON=["pilot-server"]
# AGENTCORE_RUNTIME_JWT_ALLOWED_CLIENTS_JSON=["pilot-agentcore-server"]
# AGENTCORE_RUNTIME_JWT_REQUIRED_SCOPES_JSON=["pilot.invoke_agentcore_research"]
# AGENTCORE_RUNTIME_JWT_CLIENT_CLAIM=client_id
# AGENTCORE_RUNTIME_JWT_TENANT_CLAIM=tenant_id
# AGENTCORE_RUNTIME_JWT_TENANT_ID=pilot-agentcore-event-workload
# AGENTCORE_RUNTIME_JWT_ALGORITHMS_JSON=["RS256"]
# AGENTCORE_RUNTIME_JWT_CLOCK_TOLERANCE_SECONDS=30
# AGENTCORE_RUNTIME_JWT_MAX_TOKEN_AGE_SECONDS=300
# AGENTCORE_RUNTIME_JWT_MAX_TOKEN_LIFETIME_SECONDS=600
# AGENTCORE_RUNTIME_JWT_JWKS_CACHE_TTL_MS=300000
# AGENTCORE_RUNTIME_JWT_JWKS_REFRESH_COOLDOWN_MS=10000
# AGENTCORE_RUNTIME_JWT_REVOCATION_MODE=expiry_only
# Checker mode additionally requires an injected provider-backed checker and:
# AGENTCORE_RUNTIME_JWT_REVOCATION_TIMEOUT_MS=1000
# AGENTCORE_GATEWAY_URL=https://pilotgateway-abcdefghij.gateway.bedrock-agentcore.us-east-2.amazonaws.com/mcp
# AGENTCORE_GATEWAY_TOOL_NAME=PilotReadTarget___pilot.read_market_context
# AGENTCORE_GATEWAY_AUTH_MODE=custom_jwt
# AGENTCORE_GATEWAY_PROTOCOL_VERSION=2025-11-25

AGENTCORE_TIMEOUT_MS=30000
AGENTCORE_MAX_REQUEST_BYTES=65536
AGENTCORE_MAX_RESPONSE_BYTES=262144

# Separate AgentCore Runtime container configuration. Keep this in the
# Runtime's managed non-secret configuration, not in the Pilot web process.
# The executable fails closed and does not bind port 8080 unless mode is aws.
# Never put WorkloadAccessToken, OAuth tokens, client secrets, or AWS keys here.
# AGENTCORE_RUNTIME_SERVER_MODE=off
# AGENTCORE_AWS_REGION=us-east-2
# AGENTCORE_IDENTITY_CREDENTIAL_PROVIDER_NAME=replace-with-reviewed-provider-name
# AGENTCORE_GATEWAY_URL=https://replace-with-gateway-id.gateway.bedrock-agentcore.us-east-2.amazonaws.com/mcp
# AGENTCORE_GATEWAY_TOOL_NAME=ReplaceTarget___pilot.read_market_context
# AGENTCORE_GATEWAY_JWT_ISSUER=https://replace-with-reviewed-issuer.example/
# AGENTCORE_GATEWAY_JWT_JWKS_URL=https://replace-with-reviewed-issuer.example/.well-known/jwks.json
# AGENTCORE_GATEWAY_JWT_AUDIENCES_JSON=["replace-with-reviewed-audience"]
# AGENTCORE_GATEWAY_JWT_ALLOWED_SUBJECTS_JSON=["replace-with-reviewed-workload-subject"]
# AGENTCORE_GATEWAY_JWT_ALLOWED_CLIENTS_JSON=["replace-with-reviewed-client-id"]
# AGENTCORE_GATEWAY_JWT_REQUIRED_SCOPES_JSON=["pilot.read_market_context"]
# AGENTCORE_GATEWAY_JWT_CLIENT_CLAIM=client_id
# AGENTCORE_GATEWAY_JWT_TENANT_CLAIM=tenant_id
# AGENTCORE_GATEWAY_JWT_DEPLOYMENT_TENANT_ID=replace-with-static-deployment-tenant
