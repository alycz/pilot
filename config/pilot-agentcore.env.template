# AgentCore is an optional research worker, not Pilot's model provider or
# transaction authority. The safe default performs no AgentCore calls.
AGENTCORE_MODE=off

# Local contract/demo mode only. Start the clearly labelled loopback stand-in
# in the same local harness and use the loopback origin it returns. Never use
# this mode as AWS evidence.
# AGENTCORE_MODE=standin
# AGENTCORE_STANDIN_URL=http://127.0.0.1:32147

# Future account-time AWS setup. Do not place credentials or OAuth tokens here.
# The Node server uses the normal AWS SDK credential chain for IAM/SigV4.
# AGENTCORE_MODE=aws
# AWS_REGION=us-east-1
# AGENTCORE_RUNTIME_AUTH_MODE=iam
# AGENTCORE_RUNTIME_ARN=arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/pilot_research-AbCdEf1234
# AGENTCORE_RUNTIME_QUALIFIER=pilot_v1
# AGENTCORE_GATEWAY_URL=https://pilotgateway-abcdefghij.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
# AGENTCORE_GATEWAY_TOOL_NAME=PilotReadTarget___pilot.read_market_context
# AGENTCORE_GATEWAY_AUTH_MODE=custom_jwt
# AGENTCORE_GATEWAY_PROTOCOL_VERSION=2025-11-25

AGENTCORE_TIMEOUT_MS=30000
AGENTCORE_MAX_REQUEST_BYTES=65536
AGENTCORE_MAX_RESPONSE_BYTES=262144
