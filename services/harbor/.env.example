# Non-secret defaults only. Secrets belong in an owner-controlled external Harbor environment file.
HARBOR_SOURCE_TAG=2610240
EXEC_NETWORK=testnet
MAINNET_EXECUTION=false
EXECUTOR=dynamic
HARBOR_LOCAL_DEV=true

# AWS trust layer. Local development must bind AWS_ENDPOINT_OVERRIDE to the
# loopback stand-in; live AWS credentials are event-day secrets and stay unset.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_OVERRIDE=http://127.0.0.1:8790
GUARDRAILS_MODE=mock
GUARDRAILS_THRESHOLD=0.8
KMS_MODE=off
HARBOR_KEK_CIPHERTEXT=

# QuickNode. Mock mode uses the public XRPL fallback while the local KV,
# webhook, and Streams stand-in binds to the task-isolated loopback port 8793.
# QuickNode endpoint URLs and security tokens are event-day secrets and stay unset.
QN_MODE=mock
QN_XRPL_TESTNET_HTTP=
XRPL_FALLBACK_TESTNET_HTTP=https://s.altnet.rippletest.net:51234/
QN_API_KEY=
QN_API_BASE=http://127.0.0.1:8793
QN_WEBHOOK_SECURITY_TOKEN=
QN_STREAM_SECURITY_TOKEN=
QN_RUN_TAG=run1
QN_WATCHDOG_ACTION=freeze
HARBOR_PUBLIC_URL=
