# XRPL network endpoints. Mainnet is read-only; execution must use testnet or devnet.
XRPL_MAINNET_URL=wss://s1.ripple.com
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
XRPL_DEVNET_URL=wss://s.devnet.rippletest.net:51233
XRPL_LENDING_DEVNET_URL=wss://lend.devnet.rippletest.net:51233
EXEC_NETWORK=testnet

# Harbor server connection. These values must never be exposed to browser code.
HARBOR_URL=http://localhost:8787
HARBOR_API_KEY=
HARBOR_MOCK=1

# Model access. Keys and the session secret are server-only.
DEMO_OPENROUTER_API_KEY=
MODEL_DEFAULT=nvidia/nemotron-3.5-super-vl:free
SESSION_SECRET=

# Optional test-network-only market-maker wallet. Never provide a mainnet seed.
MM_WALLET_SEED=

# Vault backend: fs or github.
VAULT_BACKEND=fs
VAULT_PATH=./vault
VAULT_GITHUB_TOKEN=
VAULT_REPO=

# x402 merchant configuration.
X402_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
X402_PAY_TO=

# Test and development signing. Both are test-network-only switches.
TEST_SIGNER=0
NEXT_PUBLIC_DEV_SIGNER=0

# Optional Xaman server-side credentials.
XAMAN_API_KEY=
XAMAN_API_SECRET=
