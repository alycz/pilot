# Public XRPL endpoints. Mainnet is read-only; execution must use testnet or devnet.
XRPL_MAINNET_URL=wss://s1.ripple.com
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
XRPL_DEVNET_URL=wss://s.devnet.rippletest.net:51233
XRPL_LENDING_DEVNET_URL=wss://lend.devnet.rippletest.net:51233
EXEC_NETWORK=testnet

# Safe manual-local default. The local-wallet profile always validates the exact
# browser and Harbor origins, even when Harbor calls are fixture-backed. The E2E
# fixture runner supplies its own scrubbed environment and intercepts its HTTP
# prerequisites; it does not read this file.
PILOT_DEPLOYMENT_PROFILE=local-wallet
# Hosted deployments must explicitly select hosted, use HTTPS Harbor, disable
# the browser development signer, and set an exact normalized HTTPS public
# origin rather than trusting reverse-proxy forwarding headers.
# PILOT_PUBLIC_ORIGIN=https://pilot.example
# Optional. HTTPS origin of the deployed docs-site/ (Vocs, basePath /docs).
# When set, Pilot serves the docs at /docs; when unset, /docs shows a fallback.
# http is accepted only for loopback, e.g. the Vocs dev server.
# PILOT_DOCS_ORIGIN=https://pilot-docs.example
# The legacy/manual local-wallet profile accepts only this loopback authority.
# This URL is public configuration; the bearer below remains server-only.
HARBOR_URL=http://127.0.0.1:8791
HARBOR_API_KEY=
# Dedicated internal-state bearer. Hosted profiles require this key for durable
# proof replay, encrypted preferences, and shared Research quota; it must use a
# different principal/token than HARBOR_API_KEY and is never browser-visible.
PILOT_HOSTED_STATE_API_KEY=
HARBOR_MOCK=1
# Default-off local trust-flow surfaces. The owner-review proxy also requires
# the matching Harbor flag and exact local Testnet profile.
HARBOR_LOCAL_X402_OWNER_REVIEW_ENABLED=false
HARBOR_LOCAL_CAPABILITY_RUNTIME_ENABLED=false
HARBOR_LOCAL_WORK_AGREEMENT_ENABLED=false
PILOT_WORK_AGREEMENT_FIXTURE=0

# Optional NEAR integrations. All are default-off. Harbor's optional 1Click
# partner credential is server-only; this source tree exposes no 1Click
# submit/deposit operation. NEAR AI credentials are likewise
# server-only, and its declared privacy tier is never treated as attested.
NEAR_INTENTS_API_KEY=
NEAR_AI_ENABLED=0
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_PRIVACY_TIER=
NEAR_RPC_READ_ENABLED=0
NEAR_RPC_NETWORK=testnet
NEAR_RPC_URL=

# The source-reviewed isolated profiles are not configured through .env files.
# Their argument-free launchers pin Pilot 127.0.0.2:3003 to ordinary Harbor
# 127.0.0.2:8791 and, for x402.pay only, dedicated Harbor 127.0.0.2:8792.
# They reject generic dotenv files and read only fixed externally managed
# credential/capability files. Do not set isolated profile markers,
# HARBOR_X402_URL, or HARBOR_X402_API_KEY here.

# Localhost-only official Testnet RLUSD onboarding. Leave disabled until the
# configured loopback Harbor instance has the reviewed FOK + forced-owner contracts.
# Local-wallet chat requires a fresh wallet proof in both mock and live Harbor
# modes. Its replay markers share this server-only state directory, which must
# be a nonblank absolute path to a preexisting, current-user-owned, non-symlink
# directory with exact mode 0700; Pilot does not create it.
P_LIVE_HARBOR_FOK_DEPLOYED=0
P_LIVE_HARBOR_OWNER_APPROVAL_DEPLOYED=0
P_LIVE_HARBOR_EXECUTION_V2=0
P_LIVE_RLUSD_ACQUISITION_STATE_DIR=

# Model access. OpenRouter's callback is derived from the current origin; no
# callback variable is needed for the fixture origin. Keys and the session
# secret are server-only. Local-wallet chat
# stays unavailable in both mock and live modes until SESSION_SECRET contains at
# least 32 characters after trimming and the absolute state directory above is set.
# Shared demo-model access is deliberately inactive until an operator supplies
# every finite limit below, a pre-existing private state directory, an exact
# :free model allowlist, verified zero-paid operator controls, and the
# server-only key. The SQLite ledger consumes the full per-request request and
# output-token quota even when provider usage is missing or cancellation is uncertain.
DEMO_OPENROUTER_API_KEY=
DEMO_MODEL_ENABLED=0
DEMO_MODEL_QUOTA_BACKEND=
DEMO_MODEL_COST_POLICY=
DEMO_MODEL_QUOTA_POLICY_VERSION=
DEMO_MODEL_STATE_DIR=
DEMO_MODEL_ALLOWED_MODELS=
DEMO_MODEL_GLOBAL_BUDGET_MICRO_USD=0
DEMO_MODEL_RESERVATION_MICRO_USD=0
DEMO_MODEL_WALLET_DAILY_BUDGET_MICRO_USD=0
DEMO_MODEL_GLOBAL_DAILY_OUTPUT_TOKENS=0
DEMO_MODEL_GLOBAL_DAILY_REQUESTS=0
DEMO_MODEL_WALLET_DAILY_OUTPUT_TOKENS=0
DEMO_MODEL_WALLET_DAILY_REQUESTS=0
DEMO_MODEL_RATE_WINDOW_SECONDS=0
DEMO_MODEL_RATE_REQUESTS=0
DEMO_MODEL_MAX_GLOBAL_CONCURRENCY=0
DEMO_MODEL_MAX_WALLET_CONCURRENCY=0
DEMO_MODEL_RESERVATION_TTL_SECONDS=0
DEMO_MODEL_ABORT_GRACE_SECONDS=0
DEMO_MODEL_MAX_INPUT_BYTES=0
DEMO_MODEL_MAX_OUTPUT_TOKENS=0
DEMO_MODEL_MAX_STEPS=0
DEMO_OPENROUTER_FREE_ONLY_ACCEPTANCE=
DEMO_OPENROUTER_KEY_LIMIT_USD=
DEMO_OPENROUTER_INCLUDE_BYOK_IN_LIMIT=
DEMO_OPENROUTER_NO_BYOK=
DEMO_OPENROUTER_PAID_ADDONS_DISABLED=
MODEL_DEFAULT=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_ALLOWED_MODELS=
SESSION_SECRET=
DEMO_CHAT_RATE_LIMIT=10

# Optional public stable-asset configuration, normally written by a separately
# authorized seed run. Testnet acceptance remains fixed to official RLUSD.
STABLE_CODE=
STABLE_CODE_TESTNET=
STABLE_ISSUER_TESTNET=
STABLE_CODE_DEVNET=
STABLE_ISSUER_DEVNET=

# AWS trust layer. Local development stays on deterministic mocks/stand-ins;
# event-day credentials remain server-only and are never committed.
AWS_REGION=us-east-2
BEDROCK_MODE=mock
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_MODELS=
BEDROCK_DAILY_TURN_CAP=50

# Optional test-network-only market-maker wallet. Leave blank for this local
# runbook. Never provide a mainnet seed or enable automatic funding/signing.
MM_WALLET_SEED=
ALLOW_TEST_CREDENTIAL_PERSISTENCE=0

# Vault backend: fs or github.
VAULT_BACKEND=fs
VAULT_PATH=./vault
VAULT_GITHUB_TOKEN=
VAULT_REPO=

# Structured preferences are default-off. When enabled, tenant identity is
# server-owned and private state must be outside VAULT_PATH so forget does not
# leave personal values in vault Git history.
PILOT_STRUCTURED_PREFERENCES=0
PILOT_PERSONALIZATION_BACKEND=local
PILOT_PERSONALIZATION_TENANT_ID=
PILOT_PERSONALIZATION_STATE_DIR=
# Development/test only: a fixed synthetic scope for exercising the real
# preference APIs with mock Harbor. It is rejected in production and is not
# wallet authorization.
PILOT_PERSONALIZATION_FIXTURE=0

# External Research reads remain disabled. Hosted/serverless deployments may
# select harbor-d1 only when the matching internal Harbor policy is enabled;
# sqlite-single-host remains restricted to one local process and private path.
BACKTEST_EXTERNAL_READS_ENABLED=0
BACKTEST_QUOTA_BACKEND=
BACKTEST_QUOTA_POLICY_VERSION=pilot.backtest.external-read.v1
BACKTEST_QUOTA_ACCOUNT_HOURLY_RUNS=0
BACKTEST_QUOTA_SESSION_HOURLY_RUNS=0
BACKTEST_QUOTA_STATE_DIR=

# x402 merchant configuration is retained for compatibility, but P2.10 is
# skipped in this localhost-only run. Leave X402_PAY_TO blank.
X402_FACILITATOR_URL=https://xrpl-facilitator-testnet.t54.ai
X402_PAY_TO=

# AP4M display/event endpoints are public configuration. The audience defaults
# to the mock Harbor identity when blank; merchant events stay disconnected.
AP4M_HARBOR_AUDIENCE=
AP4M_MERCHANT_EVENTS_URL=

# Hermes proposal transport is default-off. Activation requires every private
# path, digest, credential, consent, retention, bridge-control, and egress field
# below to pass the fail-closed runtime checks; blanks are not activation values.
PILOT_HERMES_ENABLED=0
PILOT_HERMES_ORIGIN=
PILOT_HERMES_PROFILE=
PILOT_HERMES_API_KEY=
PILOT_HERMES_PROVIDER=
PILOT_HERMES_MODEL=
PILOT_HERMES_RETENTION_DAYS=
PILOT_HERMES_TERMS_VERSION=
PILOT_HERMES_CONSENT_SECRET=
PILOT_HERMES_RETENTION_STATE_PATH=
PILOT_HERMES_DAILY_CALL_LIMIT=
PILOT_HERMES_PRIVATE_ROOT=
PILOT_HERMES_MANIFEST_PATH=
PILOT_HERMES_MANIFEST_SHA256=
PILOT_HERMES_PROFILE_CONFIG_PATH=
PILOT_HERMES_EGRESS_ORIGIN=
PILOT_HERMES_PROFILE_PROVIDER=
PILOT_HERMES_PROFILE_MODEL=
PILOT_HERMES_BRIDGE_CONTROL_ORIGIN=
PILOT_HERMES_BRIDGE_CONTROL_BEARER=
PILOT_HERMES_BRIDGE_CONTROL_RESPONSE_KEY=
PILOT_HERMES_PROFILE_INVARIANTS_SHA256=
PILOT_HERMES_BRIDGE_CONFIG_SHA256=
PILOT_HERMES_ACL_HELPER_PATH=

# Test and development signing are test-network-only switches. Local defaults
# are off; the documented lanes never sign or fund automatically.
TEST_SIGNER=0
NEXT_PUBLIC_DEV_SIGNER=0

# Ledger owner signing. Virtual Ledger is local/test-network only; its upstream is server-only.
LEDGER_MODE=webhid
LEDGER_SPECULOS_URL=
LEDGER_DEFAULT_ACCOUNT_INDEX=0
LEDGER_CHAT_SESSION_PROOF=0

# Optional Xaman server-side credentials.
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Playwright lanes. These runner-only values are read from the shell process;
# the README commands pass them explicitly. Fixture is the only default and
# starts 127.0.0.1:3004.
# Hosted-read and authenticated-live use an already-running Pilot and fail
# closed unless their exact opt-in gate is 1. Neither lane may sign or fund.
PILOT_E2E_LANE=fixture
PILOT_E2E_BASE_URL=http://127.0.0.1:3004
PILOT_E2E_ALLOW_HOSTED_READ=0
PILOT_E2E_ALLOW_AUTHENTICATED_LIVE=0
PILOT_E2E_NETWORK=testnet
