# AGENTCORE_RUNTIME_MAX_CONCURRENT_REQUESTS=1

# Separate read-only Gateway Lambda target configuration. These values are
# non-secret managed configuration; the function sends no Authorization header
# and can call only the exact public XRPL Testnet JSON-RPC endpoint below.
# The generated target ID is added in a reviewed post-create update; until then
# the function remains fail-closed and must not be called ready.
# AGENTCORE_LAMBDA_GATEWAY_ID=replace-with-created-gateway-id
# AGENTCORE_LAMBDA_TARGET_ID=replace-after-target-create
# AGENTCORE_LAMBDA_TARGET_NAME=PilotReadTarget
# AGENTCORE_MARKET_XRPL_ENDPOINT=https://s.altnet.rippletest.net:51234/
# AGENTCORE_MARKET_RLUSD_ISSUER=replace-with-verified-testnet-classic-address
# AGENTCORE_MARKET_MAX_LEDGER_AGE_SECONDS=120
