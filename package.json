{
  "name": "pilot",
  "version": "0.0.0",
  "private": true,
  "description": "Pilot: an XRPL agent interface backed by Harbor",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@pilot/contracts": "workspace:*",
    "@pilot/harbor-client": "workspace:*",
    "xrpl": ">=4.3.0 <6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
